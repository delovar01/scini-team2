# Скопируй в .env и впиши свои значения. Файл .env в git не попадает.
# Ключи не коммитить и не пересылать в чат.
#
# MODEL_N_KIND — какой адаптер:
#   openai   — любой OpenAI-совместимый /chat/completions (по умолчанию)
#   gigachat — GigaChat API Сбера: токен по ключу авторизации, сертификат Минцифры
# Как получить каждый ключ — experiment/README.md, раздел «Модели».

# 1. Коммерческая через API: YandexGPT Lite, Yandex AI Studio
MODEL_1_NAME=yandexgpt-lite
MODEL_1_KIND=openai
MODEL_1_BASE_URL=https://llm.api.cloud.yandex.net/v1
MODEL_1_API_KEY=
# id каталога (b1g...) — и в MODEL_1_PROJECT, и внутри MODEL_1_ID
MODEL_1_PROJECT=
MODEL_1_ID=gpt://<id_каталога>/yandexgpt-lite/latest

# 2. Отечественная русскоязычная: GigaChat 2 Lite, Сбер
MODEL_2_NAME=gigachat-2-lite
MODEL_2_KIND=gigachat
MODEL_2_API_KEY=
MODEL_2_ID=GigaChat-2
# по умолчанию https://api.giga.chat/v1, можно не трогать
MODEL_2_BASE_URL=

# сертификат НУЦ Минцифры: путь к russian_trusted_root_ca_pem.crt
GIGACHAT_CA_BUNDLE=
# 0 — не проверять сертификат вовсе (только для пробы, по умолчанию 1)
GIGACHAT_VERIFY_SSL=1
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# 3. С открытыми весами: Gemma 4 31B через бесплатный тариф OpenRouter
MODEL_3_NAME=gemma-4-31b
MODEL_3_KIND=openai
MODEL_3_BASE_URL=https://openrouter.ai/api/v1
MODEL_3_API_KEY=
MODEL_3_ID=google/gemma-4-31b-it:free
# :free — не больше 20 запросов в минуту, держим паузу 3,5 с
MODEL_3_MIN_INTERVAL=3.5

# Общие параметры
TEMPERATURE=0
TOP_K=3
REQUEST_TIMEOUT=60
