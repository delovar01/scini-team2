# Скопируй в .env и впиши свои значения. Файл .env в git не попадает.
# Любой сервис с OpenAI-совместимым API: /v1/chat/completions
# (OpenRouter, Yandex AI Studio, локальный Ollama и т. п.)

MODEL_1_NAME=model-a
MODEL_1_BASE_URL=https://api.example.com/v1
MODEL_1_API_KEY=
MODEL_1_ID=

MODEL_2_NAME=model-b
MODEL_2_BASE_URL=https://api.example.com/v1
MODEL_2_API_KEY=
MODEL_2_ID=

MODEL_3_NAME=model-c
MODEL_3_BASE_URL=http://localhost:11434/v1
MODEL_3_API_KEY=
MODEL_3_ID=

# Общие параметры
TEMPERATURE=0
TOP_K=3
REQUEST_TIMEOUT=60
